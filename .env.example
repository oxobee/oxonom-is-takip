# ============================================================
# ArchiFlow (archii) — Environment Variables
# Copy this file as .env and fill in the values
# ============================================================

# Admin emails (comma-separated, used for Super Admin access)
ADMIN_EMAILS=

# Firebase (client config — these are safe to expose, see Firebase docs)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Gemini AI
GEMINI_API_KEY=

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=notificaciones@archiflow.app

# Push Notifications (Web Push / VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@archiflow.app

# Microsoft OneDrive / Azure AD
NEXT_PUBLIC_MS_CLIENT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ============================================================
# Feature Flags (optional — override defaults at runtime)
# Set to "true" to enable, "false" to disable
# Defaults are defined in src/lib/feature-flags.ts
# ============================================================

# --- Enabled by default ---
# NEXT_PUBLIC_FF_OFFLINE_QUEUE=true
# NEXT_PUBLIC_FF_VIRTUALIZED_LISTS=true
# NEXT_PUBLIC_FF_AUDIT_LOGS=true
# NEXT_PUBLIC_FF_RAG_SEARCH=true
# NEXT_PUBLIC_FF_GDPR_TOOLS=true
# NEXT_PUBLIC_FF_FEEDBACK_WIDGET=true
# NEXT_PUBLIC_FF_ERROR_REPORTING=true
# NEXT_PUBLIC_FF_TELEMETRY=true
# NEXT_PUBLIC_FF_BETA_MODE=true

# --- Disabled by default (enable when ready) ---
# NEXT_PUBLIC_FF_HEALTH_SCORE_PREDICTIVE=false
# NEXT_PUBLIC_FF_SSO_SAML=false
# NEXT_PUBLIC_FF_PUBLIC_API=false
# NEXT_PUBLIC_FF_WEBHOOKS_SYSTEM=false
# NEXT_PUBLIC_FF_REALTIME_COLLAB=false
# NEXT_PUBLIC_FF_MARKETPLACE=false
# NEXT_PUBLIC_FF_BI_CONNECTOR=false
# NEXT_PUBLIC_FF_FIELD_ENCRYPTION=false
