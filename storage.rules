rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read access for carnet template images (backgrounds, logos, elements)
    // These are referenced by public URL in Firestore documents
    match /tenants/{tenantId}/carnet-templates/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid in get(/databases/$(database)/documents/tenants/$(tenantId)).data.members;
    }

    // Public read for all tenant images (for carnet photos, logos, etc.)
    match /tenants/{tenantId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid in get(/databases/$(database)/documents/tenants/$(tenantId)).data.members;
    }

    // Default: deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
